{
    "manifest_version": 3,
    "name": "WA Web Chat Exporter",
    "version": "3.0",
    "description": "Export WhatsApp Web chats locally to TXT, JSON or CSV. Read-only WA-JS engine with automatic fallback to DOM auto-scroll.",
    "action": {
        "default_popup": "popup/popup.html"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "clipboardWrite",
        "storage",
        "downloads"
    ],
    "background": {
        "scripts": [
            "background.js"
        ],
        "service_worker": "background.js"
    },
    "host_permissions": [
        "*://web.whatsapp.com/*",
        "https://web.whatsapp.com/*",
        "https://generativelanguage.googleapis.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "db/page-script.js"
            ],
            "matches": [
                "*://web.whatsapp.com/*",
                "https://web.whatsapp.com/*"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "wa-exporter@local.dev",
            "strict_min_version": "128.0"
        }
    }
}