{
    "manifest_version": 3,
    "name": "WA Web Chat Exporter",
    "version": "1.0",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "clipboardWrite"
    ],
    "host_permissions": [
        "*://web.whatsapp.com/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "wa-exporter@local.dev",
            "strict_min_version": "109.0"
        }
    }
}