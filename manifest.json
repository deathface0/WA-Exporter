{
    "manifest_version": 3,
    "name": "WA Web Chat Exporter",
    "version": "2.0",
    "description": "Export WhatsApp Web chats locally to TXT, JSON, or CSV with intelligent IndexedDB and DOM auto-scroll extraction.",
    "action": {
        "default_popup": "popup/popup.html"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "clipboardWrite",
        "storage"
    ],
    "background": {
        "scripts": [
            "background.js"
        ],
        "service_worker": "background.js"
    },
    "host_permissions": [
        "*://web.whatsapp.com/*",
        "https://web.whatsapp.com/*",
        "https://generativelanguage.googleapis.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://web.whatsapp.com/*",
                "https://web.whatsapp.com/*"
            ],
            "js": [
                "ai/gemini.js",
                "db/bridge.js",
                "extraction/selectors.js",
                "extraction/parsers.js",
                "extraction/scroller.js",
                "extraction/main.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "db/page-script.js"
            ],
            "matches": [
                "*://web.whatsapp.com/*",
                "https://web.whatsapp.com/*"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "wa-exporter@local.dev",
            "strict_min_version": "109.0"
        }
    }
}